# Only needed when the client and API are on different hosts. Left unset, the client
# talks to its own origin and the dev server proxies /hub and /api to the API below.
# VITE_API_URL=https://gamenight-api.example.com

# Where the dev server proxies to. Defaults to http://localhost:5080.
# VITE_API_TARGET=http://localhost:5080
